# OpenAI 兼容接口配置（支持 OpenAI / DeepSeek / 通义千问 / 智谱等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 可选：配置 Tavily API Key 以启用 langchain_community 的 TavilySearchResults 联网搜索
TAVILY_API_KEY=

# 视觉多模态大模型选股配置 (方式 C: 环境变量无侵入控制)
# MAX_VISION_CANDIDATES: 候选池数量上限 (0 表示全量初筛标的全部审图，不截断；例如全市场初筛出 58 只则 58 只全部审图；设置 >0 则优选动能前 N 只)
MAX_VISION_CANDIDATES=0

# TARGET_QUALIFIED_STOCKS: 达标早停阈值 (0 表示不提前早停，全部审完输出；设置 >0 例如 2 则命中指定数量达标标的后即刻早停提速)
TARGET_QUALIFIED_STOCKS=0

# VISION_WORKERS: 多模态视觉并发线程数 (推荐 4)
VISION_WORKERS=4

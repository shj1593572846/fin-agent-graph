# ==============================================================================
# 1. 大模型客户端配置（支持 OpenAI / DeepSeek / 通义千问 / 智谱等）
# ==============================================================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 可选：配置 Tavily API Key 以启用 langchain_community 联网搜索
TAVILY_API_KEY=

# ==============================================================================
# 2. 视觉多模态大模型选股与调度配置
# ==============================================================================
# MAX_VISION_CANDIDATES: 候选池数量上限 (0 表示全量初筛标的全部审图，不截断；设置 >0 则优选动能前 N 只)
MAX_VISION_CANDIDATES=0

# TARGET_QUALIFIED_STOCKS: 达标早停阈值 (0 表示不提前早停，全部审完输出；设置 >0 例如 2 则命中指定数量达标标的后即刻早停提速)
TARGET_QUALIFIED_STOCKS=0

# VISION_WORKERS: 多模态视觉并发线程数 (推荐 4)
VISION_WORKERS=4

# FAST_MODE: 极速模式 (1: 开启缓存复用与秒级直驱量化引擎；0: 深度重算全量模式)
FAST_MODE=1

# NO_BROWSER: 静默运行，不在服务器强制弹出桌面浏览器 (Linux 生产或 Docker 环境必须为 1)
NO_BROWSER=1

# TASK_TIMEOUT_SECONDS: 系统定时任务调度中心任务执行超时时间（秒，默认 7200 秒 = 2小时）
TASK_TIMEOUT_SECONDS=7200

# ==============================================================================
# 3. MySQL 数据库连接配置 (Docker Compose 部署时 host 填 db，本地运行填 127.0.0.1)
# ==============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=stock
